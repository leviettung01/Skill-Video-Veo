{
  "manifest_version": 3,
  "name": "LeVietTung_autoveo",
  "version": "2.0.0",
  "description": "Lê Việt Tùng - SkillAutoVeo | Hệ thống Captcha & Token Bridge tự động cho Google Flow Veo 3 (Zalo: 0915967790)",
  "permissions": ["storage", "alarms", "tabs", "webRequest", "webRequestBlocking", "scripting", "declarativeNetRequest", "sidePanel", "cookies"],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://storage.googleapis.com/*",
    "https://*.storage.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.googleapis.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
      "extension_pages": "script-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:* https://aisandbox-pa.googleapis.com https://labs.google https://flow.google.com https://flow-content.google https://storage.googleapis.com https://*.storage.googleapis.com https://*.googleusercontent.com https://*.googleapis.com;"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*",
        "https://flow.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://labs.google/*", "https://flow.google.com/*"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeVietTung_autoveo — Lê Việt Tùng (Zalo: 0915967790)"
  }
}
