{
  "manifest_version": 3,
  "name": "LeVietTung_autoveo",
  "version": "2.2.0",
  "description": "Lê Việt Tùng - SkillAutoVeo | Hệ thống Captcha & Token Bridge tự động cho Google Flow Veo 3 (Zalo: 0915967790)",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "cookies",
    "browsingData",
    "sidePanel"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://*.google.com/*",
    "https://google.com/*",
    "https://*.recaptcha.net/*",
    "https://recaptcha.net/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*",
    "http://localhost/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LeVietTung_autoveo — Mở Bảng Điều Khiển Bên Phải (Side Panel)"
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*",
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://labs.google/*",
        "https://flow.google.com/*"
      ]
    }
  ]
}
